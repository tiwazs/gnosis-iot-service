DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
WORKSPACE_GRPC_ADDR=<workspace-grpc-host:port>
MQTT_HOST=<mqtt-host>
MQTT_PORT=1883
MQTT_USERNAME=<mqtt-user>
MQTT_PASSWORD=<mqtt-password>
SSL_USE=false

# K8S env vars
# $ set -o allexport
# $ source .env
# $ set +o allexport
# $ envsubst < deployment/k8s.yaml > deployment/k8s_patched.yaml

IMAGE_NAME=<image-name>
IMAGE_TAG=<image-tag>

K8S_MIN_REPLICAS=1
K8S_NAMESPACE=<deployment-namespace>
K8S_RESOURCES_LIMITS_CPU=500m
K8S_RESOURCES_LIMITS_MEMORY=256Mi
K8S_RESOURCES_REQUESTS_CPU=20m
K8S_RESOURCES_REQUESTS_MEMORY=30Mi
K8S_SERVICE_NAME=gnosis-iot
